<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>รายการแจ้งซ่อมทั้งหมด</title>
    <link rel="stylesheet" href="/css/output.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { font-family: 'Inter', 'IBM Plex Sans Thai', sans-serif; }
        html { scroll-behavior: smooth; }
    </style>
    </style>
</head>
<body class="bg-white min-h-screen p-4 md:py-12">
    <div class="max-w-6xl mx-auto bg-white shadow-sm rounded-3xl overflow-hidden border border-slate-100">
        <!-- Header Banner -->
        <div class="bg-white px-6 py-3 md:px-10 md:py-5 border-b border-slate-50 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 md:gap-6 relative overflow-hidden">
            <div class="absolute -top-10 -right-10 w-48 h-48 bg-slate-100/50 rounded-full blur-3xl opacity-60"></div>
            <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-indigo-100/40 rounded-full blur-2xl opacity-50"></div>
            <div class="relative z-10 border-l-4 border-sky-500 pl-6 md:pl-8">
                <div class="mb-2">
                    <span class="text-sky-600 text-xs md:text-sm font-bold uppercase tracking-[0.4em] flex items-center">
                        <span class="w-2 h-2 bg-sky-500 rounded-full mr-3 animate-pulse"></span>
                        Maintenance System
                    </span>
                </div>
                <h2 class="text-2xl md:text-4xl font-black text-slate-900 tracking-tighter uppercase leading-none flex items-center">
                    <i class="fas fa-tools mr-3 text-sky-500/20"></i>
                    รายการแจ้งซ่อมทั้งหมด
                </h2>
                <div class="mt-3 flex items-center text-slate-500 text-xs md:text-sm font-medium bg-slate-50/80 px-3 py-1.5 rounded-xl border border-slate-100 w-fit">
                    <i class="far fa-clock mr-2 text-sky-500"></i>
                    <span id="current-date-time">กำลังโหลด...</span>
                </div>
            </div>
            <div class="flex items-center gap-4 bg-slate-50 px-4 py-2 rounded-2xl border border-slate-100 shadow-sm">
                <div class="text-right">
                    <p class="text-xs font-black text-slate-900 leading-none"><%= user.username %></p>
                    <p class="text-[10px] font-bold text-sky-500 uppercase tracking-widest mt-1"><%= user.role %></p>
                </div>
                <div class="flex flex-col gap-1 border-l border-slate-200 pl-4">
                    <a href="/profile" class="text-[10px] font-bold text-slate-500 hover:text-sky-600 transition-colors flex items-center"><i class="fas fa-user-circle mr-1"></i> โปรไฟล์ของฉัน</a>
                    <% if (user.role === 'Admin') { %>
                        <a href="/users" class="text-[10px] font-bold text-slate-500 hover:text-sky-600 transition-colors flex items-center"><i class="fas fa-users-cog mr-1"></i> จัดการผู้ใช้</a>
                    <% } %>
                </div>
                <a href="/logout" class="w-8 h-8 flex items-center justify-center bg-white/80 backdrop-blur-md rounded-xl text-rose-500 hover:bg-rose-50 border border-white/50 transition-all shadow-sm" title="ออกจากระบบ">
                    <i class="fas fa-sign-out-alt"></i>
                </a>
            </div>
            <div class="flex items-center gap-3 w-full md:w-auto">
                <a href="/create" class="relative z-10 flex-grow text-sm font-bold text-white bg-sky-500/90 backdrop-blur-xl border border-white/20 px-5 py-2.5 rounded-2xl hover:bg-sky-600 shadow-xl shadow-sky-500/20 transition-all transition-transform hover:scale-105 uppercase tracking-widest shrink-0 whitespace-nowrap text-center">
                    <i class="fas fa-plus mr-2"></i> เพิ่มงานแจ้งซ่อม
                </a>
            </div>
        </div>

        <!-- Main Content (Table) -->
        <div class="p-4 md:p-10 space-y-8">
            <!-- Search Bar Section -->
            <div class="mb-6">
                <form action="/" method="GET" class="flex flex-col md:flex-row items-center gap-3" autocomplete="off">
                    <input type="hidden" name="status" value="<%= activeStatus %>">
                    <div class="relative flex-grow">
                        <input type="text" name="search" placeholder="ค้นหาผู้แจ้ง, บริษัท, อุปกรณ์ หรือสาขา..."
                               value="<%= searchTerm %>"
                               class="w-full pl-10 pr-4 py-1.5 rounded-2xl border border-slate-200 focus:ring-4 focus:ring-sky-500/10 focus:border-sky-500 outline-none transition-all text-slate-700 text-sm shadow-sm">
                        <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-600"></i>
                    </div>
                    <button type="submit" class="w-full md:w-auto bg-sky-500/90 backdrop-blur-xl border border-white/20 text-white px-4 py-1.5 rounded-2xl hover:bg-sky-600 shadow-xl shadow-sky-500/20 font-bold text-sm">
                        <i class="fas fa-search mr-2"></i>ค้นหา
                    </button>
                </form>
            </div>

            <!-- Stats Bar Section -->
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
                <a href="/?status=ทั้งหมด&search=<%= searchTerm %>#jobs-table" class="block bg-slate-100/80 p-6 rounded-3xl border-2 <%= activeStatus === 'ทั้งหมด' ? 'border-sky-500 bg-sky-100 shadow-md' : 'border-transparent shadow-sm' %> transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-sky-200/50 text-center">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">งานทั้งหมด</p>
                    <p class="text-4xl font-black text-slate-900"><%= stats.total %></p>
                </a>

                <a href="/?status=รอรับงาน&search=<%= searchTerm %>#jobs-table" class="block bg-amber-100/60 p-6 rounded-3xl border-2 <%= activeStatus === 'รอรับงาน' ? 'border-amber-500 bg-amber-100/80 shadow-md' : 'border-transparent shadow-sm' %> transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-amber-200/50 text-center text-amber-600">
                    <p class="text-xs font-bold uppercase tracking-widest mb-2">รอรับงาน</p>
                    <p class="text-4xl font-black"><%= stats.pending %></p>
                </a>

                <a href="/?status=กำลังดำเนินการ&search=<%= searchTerm %>#jobs-table" class="block bg-sky-100/60 p-6 rounded-3xl border-2 <%= activeStatus === 'กำลังดำเนินการ' ? 'border-sky-500 bg-sky-100/80 shadow-md' : 'border-transparent shadow-sm' %> transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-sky-200/50 text-center text-sky-600">
                    <p class="text-xs font-bold uppercase tracking-widest mb-2">กำลังดำเนินการ</p>
                    <p class="text-4xl font-black"><%= stats.doing %></p>
                </a>

                <a href="/?status=เสร็จสิ้น&search=<%= searchTerm %>#jobs-table" class="block bg-emerald-100/60 p-6 rounded-3xl border-2 <%= activeStatus === 'เสร็จสิ้น' ? 'border-emerald-500 bg-emerald-100/80 shadow-md' : 'border-transparent shadow-sm' %> transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-emerald-200/50 text-center text-emerald-600">
                    <p class="text-xs font-bold uppercase tracking-widest mb-2">เสร็จสิ้น</p>
                    <p class="text-4xl font-black"><%= stats.done %></p>
                </a>

                <a href="/?status=ยกเลิก&search=<%= searchTerm %>#jobs-table" class="block bg-rose-100/60 p-6 rounded-3xl border-2 <%= activeStatus === 'ยกเลิก' ? 'border-rose-500 bg-rose-100/80 shadow-md' : 'border-transparent shadow-sm' %> transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-rose-200/50 text-center text-rose-600">
                    <p class="text-xs font-bold uppercase tracking-widest mb-2">ยกเลิก</p>
                    <p class="text-4xl font-black"><%= stats.cancelled %></p>
                </a>

                <a href="/?status=ค้างเกิน 3 วัน&search=<%= searchTerm %>#jobs-table" class="block p-6 rounded-3xl border-2 <%= activeStatus === 'ค้างเกิน 3 วัน' ? 'bg-rose-200/80 border-rose-500 shadow-md' : 'bg-rose-100/30 border-dashed border-rose-200 shadow-sm' %> text-center text-rose-500 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-rose-200/50">
                    <p class="text-xs font-bold uppercase tracking-widest mb-2 flex items-center justify-center">
                        <i class="fas fa-exclamation-circle mr-1.5 text-[10px]"></i> ค้างเกิน 3 วัน
                    </p>
                    <p class="text-4xl font-black"><%= stats.overdue %></p>
                </a>
            </div>

            <!-- Table Container -->
            <table id="jobs-table" class="w-full text-left border-collapse scroll-mt-20">
                <thead class="hidden md:table-header-group">
                    <tr class="border-b border-slate-100">
                        <th class="pb-4 text-base font-bold text-slate-700 uppercase tracking-widest px-4">เลขที่งาน</th>
                        <th class="pb-4 text-base font-bold text-slate-700 uppercase tracking-widest px-4">ข้อมูลผู้แจ้ง และอุปกรณ์</th>
                        <th class="pb-4 text-base font-bold text-slate-700 uppercase tracking-widest px-4 text-center">สถานะ</th>
                        <th class="pb-4 text-base font-bold text-slate-700 uppercase tracking-widest px-4 text-right">ดูรายละเอียด และลบ</th>
                    </tr>
                </thead>
                <tbody class="md:divide-y md:divide-slate-50"> 
                    <% jobs.forEach(job => { %>
                    <% 
                        const isToday = job.created_at && 
                            new Date(job.created_at.replace(' ', 'T') + 'Z').toDateString() === new Date().toDateString();
                    %>
                    <tr class="block md:table-row mb-8 md:mb-0 rounded-[2rem] shadow-lg hover:shadow-2xl border border-slate-100 transition-all duration-500 group <%= job.status === 'ยกเลิก' ? 'bg-white border-l-4 border-rose-500 opacity-70' : (job.status === 'เสร็จสิ้น' ? 'bg-white opacity-90' : (job.status === 'กำลังดำเนินการ' ? 'bg-sky-50/40 border-sky-200' : 'bg-white')) %> hover:bg-white transform hover:-translate-y-1.5 md:hover:translate-y-0">
                        <td class="block py-3 px-4 md:table-cell md:py-6">
                            <span class="md:hidden text-[10px] font-bold text-slate-600 uppercase tracking-widest block mb-2 bg-slate-50 px-2 py-1 rounded-md border border-slate-100 w-fit">เลขที่งาน</span> 
                            <span class="text-slate-200 font-medium italic mr-1">#</span>
                            <% if (job.status === 'กำลังดำเนินการ') { %>
                                <i class="fas fa-cog text-sky-500 animate-pulse mr-1"></i>
                            <% } %>
                            <% if (job.status === 'เสร็จสิ้น') { %>
                                <i class="fas fa-check-circle text-emerald-500 mr-1"></i>
                            <% } %>
                            <% if (job.status === 'ยกเลิก') { %>
                                <i class="fas fa-times-circle text-rose-500 mr-1"></i>
                            <% } %>
                            <span class="text-slate-900 font-bold text-lg"><%= String(job.id).padStart(6, '0') %></span> 
                        </td>
                        <td class="block py-2 px-4 md:table-cell md:py-6">
                            <span class="md:hidden text-[10px] font-bold text-slate-600 uppercase tracking-widest block mb-2 bg-slate-50 px-2 py-1 rounded-md border border-slate-100 w-fit">ข้อมูลผู้แจ้ง และอุปกรณ์</span>
                            <div class="flex flex-col">
                                <!-- แสดงบริษัทและสาขา -->
                                <div class="flex flex-wrap items-center gap-x-2 text-sky-800 font-bold text-sm md:text-base">
                                    <span><i class="fas fa-building mr-1.5"></i><%= job.reporter_company || 'ไม่ระบุบริษัท' %></span>
                                    <span class="text-slate-300">|</span>
                                    <span><i class="fas fa-sitemap mr-1.5"></i><%= job.branch_name %></span>
                                </div>

                                <!-- แสดงชื่อผู้แจ้งและแผนก -->
                                <div class="flex flex-wrap items-center gap-x-2 mt-1">
                                    <span class="text-slate-900 font-medium text-base md:text-lg">
                                        <i class="fas fa-user-circle mr-2 text-slate-400"></i><%= job.reporter_name %>
                                    </span>
                                    <span class="bg-slate-100 text-slate-500 text-[10px] px-2 py-0.5 rounded-md font-bold uppercase tracking-wider">
                                        <%= job.reporter_dept || 'ไม่ระบุแผนก' %>
                                    </span>
                                    <span class="bg-slate-100 text-slate-500 text-[10px] px-2 py-0.5 rounded-md font-bold uppercase tracking-wider">
                                        <%= job.reporter_pos || 'ไม่ระบุตำแหน่ง' %>
                                    </span>
                                </div>

                                <span class="text-slate-900 font-normal text-sm md:text-base mt-1">
                                    <i class="fas fa-cube mr-2 text-sky-700"></i><%= job.equipment_name %>
                                </span>
                                <span class="<%= isToday ? 'text-sky-600 font-bold' : 'text-slate-500' %> text-sm mt-1 flex items-center <%= job.is_overdue ? 'text-rose-600' : '' %>">
                                    <i class="fas fa-calendar-alt mr-2 <%= isToday ? 'text-sky-600' : 'text-sky-700' %>"></i>
                                    <%= formatDateThai(job.created_at) %>
                                    <% if (isToday) { %>
                                        <span class="ml-2 bg-sky-100 text-sky-700 text-[10px] px-1.5 py-0.5 rounded-md uppercase font-black tracking-tighter">วันนี้</span>
                                    <% } %>
                                    <span class="ml-2 px-2 py-0.5 rounded-md text-[10px] font-bold border uppercase tracking-wider <%= getUrgencyClass(job.urgency) %>">
                                        <%= job.urgency || 'ปกติ' %>
                                    </span>
                                    <% if (job.technician_notes) { %>
                                        <span class="ml-2 inline-flex items-center text-[10px] font-bold text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded-md border border-amber-100 uppercase tracking-tighter" title="มีหมายเหตุจากช่าง">
                                            <i class="fas fa-comment-dots mr-1"></i> มีหมายเหตุ
                                        </span>
                                    <% } %>
                                    <% if (job.log_count > 0) { %>
                                        <span class="ml-2 inline-flex items-center text-[10px] font-bold text-sky-600 bg-sky-50 px-1.5 py-0.5 rounded-md border border-sky-100 uppercase tracking-tighter" title="มีประวัติการเปลี่ยนสถานะ">
                                            <i class="fas fa-history mr-1"></i> มีประวัติ
                                        </span>
                                    <% } %>
                                </span>
                            </div>
                        </td> 
                        <td class="block py-3 px-4 md:table-cell md:py-6 md:text-center flex items-center md:justify-center">
                            <span class="md:hidden text-[10px] font-bold text-slate-600 uppercase tracking-widest block mr-4 bg-slate-50 px-2 py-1 rounded-md border border-slate-100 w-fit shrink-0">สถานะ</span>
                            <% 
                                let statusClass = 'bg-slate-100 text-slate-600';
                                if(job.status === 'รอรับงาน') statusClass = 'bg-amber-50 text-amber-600 border border-amber-100';
                                if(job.status === 'กำลังดำเนินการ') statusClass = 'bg-sky-50 text-sky-600 border border-sky-100';
                                if(job.status === 'เสร็จสิ้น') statusClass = 'bg-emerald-50 text-emerald-600 border border-emerald-100';
                                if(job.status === 'ยกเลิก') statusClass = 'bg-rose-50 text-rose-600 border border-rose-100';
                            %>
                            <span class="<%= statusClass %> px-4 py-1.5 rounded-full text-sm font-bold uppercase tracking-wider inline-flex items-center">
                                <% if(job.status === 'กำลังดำเนินการ') { %>
                                    <i class="fas fa-spinner fa-spin mr-2"></i>
                                <% } else { %>
                                    <span class="w-1.5 h-1.5 rounded-full bg-current mr-2"></span>
                                <% } %>
                                <%= job.status %> 
                            </span>
                        </td>
                        <td class="block py-3 px-4 md:table-cell md:py-6 text-right">
                            <span class="md:hidden text-[10px] font-bold text-slate-600 uppercase tracking-widest block mb-2 text-left bg-slate-50 px-2 py-1 rounded-md border border-slate-100 w-fit">ดูรายละเอียด และลบ</span>
                            <div class="flex flex-row md:justify-end items-center gap-2">
                                <a href="/job/<%= job.id %>" 
                                   class="flex-1 md:flex-none inline-flex items-center justify-center px-3 py-1.5 rounded-xl bg-sky-50/70 backdrop-blur-md text-sky-600 border border-sky-100/50 hover:bg-sky-500 hover:text-white hover:shadow-xl hover:shadow-sky-500/20 transition-all active:scale-95 font-bold text-sm">
                                    <i class="fas fa-eye text-sm"></i>
                                    <span class="ml-2">ดูรายละเอียด</span>
                                </a> 

                                <% if (user.role === 'Admin') { %>
                                    <form action="/job/<%= job.id %>/delete" method="POST" class="flex-1 md:flex-none inline" onsubmit="return confirm('คุณต้องการลบรายการนี้ใช่หรือไม่?')">
                                        <button type="submit" 
                                                class="w-full inline-flex items-center justify-center px-3 py-1.5 rounded-xl bg-rose-50/70 backdrop-blur-md text-rose-600 border border-rose-100/50 hover:bg-rose-500 hover:text-white hover:shadow-xl hover:shadow-sky-500/20 transition-all active:scale-95 font-bold text-sm">
                                            <i class="fas fa-trash-alt text-sm"></i>
                                            <span class="ml-2">ลบ</span>
                                        </button>
                                    </form> 
                                <% } %>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                    <% if (jobs.length === 0) { %>
                    <tr>
                        <td colspan="4" class="py-20 text-center text-slate-400 italic">
                            ไม่พบรายการแจ้งซ่อมในขณะนี้
                        </td>
                    </tr>
                    <% } %>
                </tbody>
            </table>

            <!-- ระบบการแบ่งหน้า (Pagination) -->
            <% if (totalPages > 1) { %>
            <div class="mt-8 flex flex-col md:flex-row items-center justify-between gap-6 border-t border-slate-100 pt-8">
                <div class="text-slate-500 text-sm font-medium">
                    แสดงหน้าที่ <span class="text-slate-900 font-bold"><%= currentPage %></span> จากทั้งหมด <span class="text-slate-900 font-bold"><%= totalPages %></span> หน้า
                </div>
                <div class="flex items-center gap-2">
                    <% if (currentPage > 1) { %>
                        <a href="/?status=<%= activeStatus %>&search=<%= searchTerm %>&page=<%= currentPage - 1 %>#jobs-table" 
                           class="px-4 py-2 rounded-xl bg-white/60 backdrop-blur-md border border-white/50 text-slate-600 hover:bg-white transition-all font-bold text-sm flex items-center shadow-sm">
                            <i class="fas fa-chevron-left mr-2 text-xs"></i> ก่อนหน้า
                        </a>
                    <% } %>

                    <div class="hidden sm:flex items-center gap-2">
                        <% for(let i = 1; i <= totalPages; i++) { %>
                            <a href="/?status=<%= activeStatus %>&search=<%= searchTerm %>&page=<%= i %>#jobs-table" 
                               class="w-10 h-10 flex items-center justify-center rounded-xl font-bold text-sm transition-all <%= currentPage === i ? 'bg-sky-500/90 backdrop-blur-md text-white shadow-xl shadow-sky-500/20 border border-white/20' : 'bg-white/60 backdrop-blur-md border border-white/50 text-slate-600 hover:bg-white shadow-sm' %>">
                                <%= i %>
                            </a>
                        <% } %>
                    </div>

                    <% if (currentPage < totalPages) { %>
                        <a href="/?status=<%= activeStatus %>&search=<%= searchTerm %>&page=<%= currentPage + 1 %>#jobs-table" 
                           class="px-4 py-2 rounded-xl bg-white/60 backdrop-blur-md border border-white/50 text-slate-600 hover:bg-white transition-all font-bold text-sm flex items-center shadow-sm">
                            ถัดไป <i class="fas fa-chevron-right ml-2 text-xs"></i>
                        </a>
                    <% } %>
                </div>
            </div>
            <% } %>
        </div>
    </div>

    <script>
        function updateDateTime() {
            const now = new Date();
            const formatter = new Intl.DateTimeFormat('th-TH', {
                weekday: 'long',
                day: 'numeric',
                month: 'long',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit'
            });
            document.getElementById('current-date-time').textContent = formatter.format(now) + ' น.';
        }
        setInterval(updateDateTime, 1000);
        updateDateTime();
    </script>
</body>
</html>